# GitHub OAuth App credentials
GITHUB_ID=
GITHUB_SECRET=

# Signs session cookies
AUTH_SECRET=

# LLM provider key for revival plans
LLM_API_KEY=

# Optional: token for demo mode, raises GitHub rate limits
GITHUB_DEMO_TOKEN=

# GitHub username whose public repos are shown in demo mode
GITHUB_DEMO_USERNAME=

# Base URL of the app, used by Auth.js for callbacks
NEXTAUTH_URL=

# Optional, server only: override the GitHub API base URL (http or https). Used by e2e tests.
GITHUB_API_BASE_URL=
